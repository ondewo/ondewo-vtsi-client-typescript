{
  "name": "@ondewo/vtsi-client-typescript",
  "version": "9.2.0",
  "description": "ONDEWO Voip Telephone System Integration (VTSI) Client library for Typescript",
  "author": "ONDEWO GmbH <office@ondewo.com>",
  "homepage": "https://ondewo.com",
  "license": "Apache-2.0",
  "keywords": [
    "ondewo",
    "vtsi",
    "api",
    "client",
    "typescript",
    "grpc"
  ],
  "main": "public-api.js",
  "typings": "public-api.d.ts",
  "scripts": {
    "start": "npm run build",
    "build": "docker run -v ${PWD}:/input-volume -v ${PWD}/..:/output-volume ondewo-typescript-proto-compiler ondewo-vtsi-api ondewo",
    "predebug": "mv ondewo-vtsi-api/googleapis/google ondewo-vtsi-api/google",
    "debug": "docker run --entrypoint /bin/bash -v ${PWD}:/input-volume -v ${PWD}/..:/output-volume ondewo-typescript-proto-compiler"
  },
  "repository": {
    "type": "git",
    "directory": "https://github.com/ondewo/ondewo-vtsi-client-typescript"
  },
  "dependencies": {
    "google-protobuf": "4.0.2",
    "grpc-web": "^1.5.0",
    "tslib": "^2.8.1",
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.27",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "dotenv": "^16.4.5",
    "eslint": "^10.12.0",
    "global": "^4.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10"
  }
}
